APP_NAME=MIRAGE
ENVIRONMENT=production

# Telegram authentication and owner access
BOT_TOKEN=
OWNER_TELEGRAM_ID=
ALLOWED_TELEGRAM_IDS=
MAX_USERS=4
MINI_APP_URL=https://your-service.onrender.com

# Database (Render PostgreSQL in production; SQLite may be used locally)
DATABASE_URL=sqlite:///./trading_intelligence.db

# Encryption key used only for exchange API credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable, private and backed up. Never commit the actual key.
EXCHANGE_ENCRYPTION_KEY=

# Live order execution is deliberately hard-disabled in this release.
LIVE_TRADING_ENABLED=false

# Optional application secret / service settings
SECRET_KEY=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_URL=
SCAN_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15

# Telegram signal notifications are OFF by default (fail-closed).
# To opt in later, set ENABLED=true and START_AFTER to a UTC ISO timestamp
# created after deployment, e.g. 2026-11-13T19:00:00Z. No old signals are queued.
SIGNAL_NOTIFICATIONS_ENABLED=false
SIGNAL_NOTIFICATIONS_START_AFTER=
SIGNAL_NOTIFICATIONS_MAX_SIGNALS_PER_CYCLE=1
SIGNAL_NOTIFICATIONS_DELAY_SECONDS=2
